TASKIFY_PRIMARY.ENV="local"

TASKIFY_SERVER.PORT="8080"
TASKIFY_SERVER.READ_TIMEOUT="30"
TASKIFY_SERVER.WRITE_TIMEOUT="30"
TASKIFY_SERVER.IDLE_TIMEOUT="60"
TASKIFY_SERVER.CORS_ALLOWED_ORIGINS="http://localhost:3000"

TASKIFY_DATABASE.HOST="localhost"
TASKIFY_DATABASE.PORT="5432"
TASKIFY_DATABASE.USER="postgres"
TASKIFY_DATABASE.PASSWORD=""
TASKIFY_DATABASE.NAME="taskify"
TASKIFY_DATABASE.SSL_MODE="disable"
TASKIFY_DATABASE.MAX_OPEN_CONNS="25"
TASKIFY_DATABASE.MAX_IDLE_CONNS="25"
TASKIFY_DATABASE.CONN_MAX_LIFETIME="300"
TASKIFY_DATABASE.CONN_MAX_IDLE_TIME="300"

TASKIFY_AUTH.SECRET_KEY="secret"

TASKIFY_INTEGRATION.RESEND_API_KEY="resend_key"

TASKIFY_REDIS.ADDRESS="redis://localhost:6379"

# ============================================================================
# OBSERVABILITY CONFIGURATION
# ============================================================================

# Service Identity
TASKIFY_OBSERVABILITY.SERVICE_NAME="taskify"
TASKIFY_OBSERVABILITY.ENVIRONMENT="development"

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Basic Logging Settings
TASKIFY_OBSERVABILITY.LOGGING.LEVEL="debug"
TASKIFY_OBSERVABILITY.LOGGING.FORMAT="console"
TASKIFY_OBSERVABILITY.LOGGING.SLOW_QUERY_THRESHOLD="100ms"

# ============================================================================
# NEW RELIC CONFIGURATION
# ============================================================================

# New Relic APM
TASKIFY_OBSERVABILITY.NEW_RELIC.LICENSE_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TASKIFY_OBSERVABILITY.NEW_RELIC.APP_LOG_FORWARDING_ENABLED="true"
TASKIFY_OBSERVABILITY.NEW_RELIC.DISTRIBUTED_TRACING_ENABLED="true"
TASKIFY_OBSERVABILITY.NEW_RELIC.DEBUG_LOGGING="false"

# ============================================================================
# HEALTH CHECKS CONFIGURATION
# ============================================================================

# Health Check Settings
TASKIFY_OBSERVABILITY.HEALTH_CHECKS.ENABLED="true"
TASKIFY_OBSERVABILITY.HEALTH_CHECKS.INTERVAL="30s"
TASKIFY_OBSERVABILITY.HEALTH_CHECKS.TIMEOUT="5s"
TASKIFY_OBSERVABILITY.HEALTH_CHECKS.CHECKS="database,redis"